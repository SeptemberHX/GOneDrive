# systemd *user* unit. The sync daemon runs as the user, never as root:
# it holds the account's tokens and writes into the user's home directory.
#
#   install: ~/.config/systemd/user/gonedrived.service
#   enable:  systemctl --user enable --now gonedrived.service
[Unit]
Description=GOnedrive sync daemon
Documentation=https://github.com/monotune/GOnedrive
# The daemon needs the session bus for its own interface and the Secret
# Service for the refresh token.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/gonedrived run
Restart=on-failure
RestartSec=10
# A sync client that dies repeatedly should stop, not thrash the API.
StartLimitBurst=5
StartLimitIntervalSec=300

# Hardening — seccomp/capability class only, deliberately NOT mount-namespace
# class. The daemon connects to the privileged helper's root-owned socket at
# /run/gonedrive/hsm.sock; in a *user* manager systemd implements every
# mount-namespace protection (ProtectSystem, ProtectHome, PrivateTmp,
# ProtectKernelTunables, ProtectControlGroups, …) via a user namespace, inside
# which that root-owned socket is remapped to an unmapped uid and connect()
# fails with EACCES — files-on-demand then silently goes dark. So we keep the
# protections that need no mount namespace and drop the ones that do; a user
# daemon already has full access to the user's own data, which is the thing
# actually worth guarding, so ProtectSystem buys little here anyway.
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=graphical-session.target
