# System service for GOnedrive's files-on-demand helper.
#
# This is the only privileged piece of GOnedrive. It holds no credentials and
# never touches the network; it forwards kernel pre-content events to the
# user's unprivileged daemon and writes hydrated bytes through the kernel's
# own descriptors. See crates/gonedrive-hsm.
#
#   install: /etc/systemd/system/gonedrive-hsm.service
#   enable:  sudo systemctl enable --now gonedrive-hsm.service
[Unit]
Description=GOnedrive files-on-demand helper
Documentation=https://github.com/monotune/GOnedrive

[Service]
Type=simple
ExecStart=/usr/local/bin/gonedrive-hsm
# Any exit, not only a failed one: while the helper is down every placeholder
# on the machine reads as zeroes, and a "clean" SIGHUP or SIGTERM from outside
# must not be allowed to leave it that way.
Restart=always
RestartSec=5
# A malformed-event or filesystem-error loop must not fill the system journal.
LogRateLimitIntervalSec=1min
LogRateLimitBurst=30
# Exportable filesystems use persistent inode handles and one anchor descriptor
# per mount. Keep a high ceiling for the safety-preserving descriptor fallback
# on filesystems that cannot reopen handles; the ceiling itself allocates no fd.
LimitNOFILE=524288

# Runs as root for CAP_SYS_ADMIN (fanotify pre-content). CAP_FOWNER is needed
# only to restore a user's placeholder mode after a replacement mark succeeds.
# The socket still restricts every operation to files owned by its peer uid.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_FOWNER
NoNewPrivileges=true
ProtectSystem=strict
# ProtectHome must remain unset: hydration, xattr updates, and safety-mode
# restoration intentionally mutate peer-authorized files below the sync root.
# The helper still has no credentials or network access, validates peer UID and
# inode ownership, and only operates on descriptors authorized by fanotify.
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
RuntimeDirectory=gonedrive
PrivateTmp=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
